---
import { Image } from "astro:assets";
import jamie from "../assets/jamie.png";
---

<footer class="flex justify-center px-6 py-8 text-base text-muted-foreground sm:text-sm">
  <a
    href="https://jamiedavenport.me"
    target="_blank"
    rel="noopener noreferrer"
    class="flex min-h-11 items-center gap-3 rounded-full px-3 font-normal hover:text-foreground focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-ring"
  >
    <Image
      src={jamie}
      alt=""
      width={28}
      height={28}
      densities={[1, 2]}
      class="size-7 shrink-0 rounded-full outline-1 -outline-offset-1 outline-black/10 dark:outline-white/10"
    />
    <span>Built by Jamie Davenport</span>
  </a>
</footer>
